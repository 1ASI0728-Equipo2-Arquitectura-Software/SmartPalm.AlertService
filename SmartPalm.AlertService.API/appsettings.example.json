{
  "ConnectionStrings": { 
    "AlertDatabase": "Host=localhost;Port=5437;Database=smartpalm_alert;Username=smartpalm_alert;Password=change-me"
  },
  "Jwt": { 
    "Issuer": "smartpalm.identity", 
    "Audience": "smartpalm.clients", 
    "Key": "shared-secure-key-at-least-32-bytes"
  },
  "RabbitMq": { 
    "Enabled": true, 
    "Uri": "amqp://guest:guest@localhost:5672/", 
    "Exchange": "smartpalm.events", 
    "Queue": "smartpalm.alert"
  },
  "Firebase": { 
    "Enabled": false, 
    "CredentialsJson": "", 
    "Topic": "alerts"
  },
    "Logging": { 
    "LogLevel": { 
      "Default": "Information", 
      "Microsoft.AspNetCore": "Warning" 
    } 
  },
  "AllowedHosts": "*"
}
